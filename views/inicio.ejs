<!DOCTYPE html>
<html lang="es">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title><%= titulo %></title>
        <link rel="stylesheet" href="/bootstrap/css/bootstrap.min.css">
    </head>
    <body class="bg-light">
        <!-- Menú de Navegación amigable con Bootstrap -->
        <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
            <div class="container">
                <a class="navbar-brand" href="/">Aprendiendo Node.js</a>
                <div class="navbar-nav">
                    <a class="nav-link active" href="/">Inicio</a>
                    <a class="nav-link" href="/servicios">Servicios</a>
                </div>
            </div>
        </nav>

        <!-- Contenido Principal -->
        <main class="container my-5">
            <div class="p-5 mb-4 bg-white rounded-3 shadow-sm border">
                <div class="container-fluid py-5">
                    <h1 class="display-5 fw-bold text-primary">¡Bienvenidos a la Web Dinámica!</h1>
                    <p class="col-md-8 fs-4 text-muted">Esta página está siendo renderizada en tiempo real por un servidor en Node.js utilizando Express y estilizada de forma responsiva con Bootstrap.</p>
                    <a href="/servicios" class="btn btn-primary btn-lg mt-3">Ver nuestros servicios</a>
                </div>
            </div>
        </main>

        <footer class="text-center py-4 my-4 border-top text-muted">
            &copy; <%= new Date().getFullYear() %> - Mi Primer Servidor Fullstack
        </footer>

        <!-- JS de Bootstrap -->
        <script src="/bootstrap/js/bootstrap.min.js"></script>
    </body>
</html>